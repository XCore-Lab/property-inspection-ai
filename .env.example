# Copy to .env (local runs: run_local.bat / run_local.sh load it). Never commit the real file.

# --- Gemini: EITHER an AI Studio key (local / quick test) ...
PI_GEMINI_API_KEY=
# ... OR Vertex AI (Cloud Run uses its service account; locally: gcloud auth application-default login)
PI_GEMINI_VERTEX=0
PI_GCP_PROJECT=
PI_GCP_LOCATION=global
PI_GEMINI_MODEL=gemini-3.8-flash

# --- Google Cloud integrations (optional; empty = off)
PI_GCS_BUCKET=
PI_BQ_DATASET=
PI_PUBSUB_TOPIC=

# --- simple API protection for a public demo (empty = open)
PI_API_KEY=

# --- risk engine
PI_CURRENCY=USD
PI_COST_MULTIPLIER=1.0

# --- 3D engine: DA3-SMALL (fastest) or DA3-BASE (default)
PI_DA3_MODEL=DA3-BASE

# --- local models (LocateAnything-3B + Gemma 4 E4B, Depth Anything 3): models/ and bin/ in this folder (defaults).
# 6-8 GB GPU: swap (one local model at a time). L4 24 GB: coexist.
PI_GPU_RESIDENCY=swap
